//////////////////////////
// Essência Elegante
//
// Banco de Dados Oficial
//////////////////////////

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////
// ENUMS
//////////////////////

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  APPLE
}

enum AccountType {
  CREDENTIALS
  OAUTH
}

/////////////////////////
//
// AUTHENTICATION
//
////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  name          String    @db.VarChar(150)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?   @db.VarChar(15)

  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  accounts Account[]
  sessions Session[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          AuthProvider
  providerAccountId String       @db.VarChar(255)
  type              AccountType  @default(CREDENTIALS)
  refreshToken      String?      @db.Text
  accessToken       String?      @db.Text
  expiresAt         Int?
  tokenType         String?      @db.VarChar(50)
  scope             String?      @db.VarChar(255)
  idToken           String?      @db.Text
  sessionState      String?      @db.VarChar(255)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionToken String @unique @db.VarChar(255)

  expires DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id String @id @default(uuid()) @db.Uuid

  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime

  createdAt DateTime @default(now())

  @@unique([identifier, token])
}


///////////////////////////
//
// CATALOG
//
//////////////////////////

model Category{

id String @id @default(uuid()) @db.Uuid

parentId String? @db.Uuid

parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

children Category[] @relation("CategoryHierarchy")

products Product[]

name String db.VarChar(150)
slug String @unique @db.VarChar(160)
description String? db.Text

isActive Boolean @default(true)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?

@@index([parentId])

}



model Product {

id String @id @default(uuid()) @db.Uuid

categoryId String @db.Uuid

category Category @relation( fields: [categoryId], references: [id], onDelete: Restrict)

variants ProductVariant[]


name String @db.VarChar(200)
slug String @unique @db.VarChar(220)
description String? @db.Text
isActive Boolean @default(true)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?

@@index([categoryId])

}



model Color{

id String @id @default(uuid()) @db.Uuid

variants ProductVariant[]

name String @unique @db.VarChar(50)
hexCode String? @db.VarChar(7)

createdAt DateTime @default(now())

}



model Size {

id String @id @default(uuid()) @db.Uuid

variants ProductVariant[]

label String @unique @db.VarChar(20)
sortOrder int @default(0)

createdAt DateTime @default(now())

}



model ProductVariant{

id String @id @default(uuid()) @db.Uuid

productId String @db.Uuid

product Product @relation( fields: [productId], references: [id], onDelete: Cascade)

colorId String? @db.Uuid

color Color? @relation( fields: [colorId], references: [id], onDelete: Restrict)

sizeId String? @db.Uuid

size Size? @relation( fields: [sizeId], references: [id], onDelete: Restrict)

images ProductImage[]

sku String @unique @db.VarChar(50)
price Decimal @db.Decimal(10, 2)
stock Int @default(0)
isActive Boolean @default(true)

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?

@@index([productId])
@@index([colorId])
@@index([sizeId])

}



model ProductImage{

  id String @id @default(uuid()) @db.Uuid

  variantId String @db.Uuid

  variant ProductVariant @relation( fields: [variantId], references: [id], onDelete: Cascade)

  url String @db.Text
  altText String? @db.VarChar(200)
  isPrimary Boolean @default(false)
  sortOrder int @default(0)


  createdAt DateTime @default(now())
 

  @@index([variantId])


}


